# MUSTAFA LIFE - Environment Variables Template
# Copy this file to .env.local and fill in your Supabase project credentials.

# 1. Supabase Project URL (from Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Supabase Anonymous Public Key (from Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
