# ==============================================================================
# HERBAL E COM LIFE - SUPABASE ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env.local and populate with your Supabase credentials:
# cp .env.local.example .env.local
#
# IMPORTANT:
# 1. Real credentials must be placed in .env.local (which is gitignored).
# 2. Never commit .env.local or expose your Supabase Service Role Key to the client.

# 1. Supabase Project URL (From Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Supabase Anon Public Key (From Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
